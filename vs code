import re
import pandas as pd

# ۱. خواندن فایل اکسل
df = pd.read_excel('file.xlsx')  # نام فایل اکسل خود را اینجا وارد کنید


# تابعی برای تمیزکاری تاریخ (حذف عبارات اضافی)
def clean_date(text):
    if pd.isna(text):
        return ''
    text = str(text)
    # حذف عبارات "از تاریخ" و "به مدت 5 سال"
    text = text.replace('از تاریخ', '').replace('به مدت 5 سال', '').strip()
    return text


# تابعی برای اضافه کردن ۵ سال به تاریخ شمسی
def add_5_years(date_str):
    if not date_str:
        return ''
    # پیدا کردن بخش‌های سال، ماه و روز
    match = re.search(r'(\d{4})/(\d{1,2})/(\d{1,2})', date_str)
    if match:
        year = int(match.group(1))
        month = match.group(2)
        day = match.group(3)

        # اضافه کردن ۵ سال به سال فعلی
        new_year = year + 5

        # فرمت‌دهی مجدد تاریخ
        return f'{new_year}/{month}/{day}'
    return date_str


# ۲. تمیز کردن ستون فعلی (تاریخ شروع)
df['تاریخ اعتبار اتحادیه'] = df['تاریخ اعتبار اتحادیه'].apply(clean_date)

# ۳. ایجاد ستون جدید و اضافه کردن ۵ سال
df['تاریخ انقضا (۵ سال بعد)'] = df['تاریخ اعتبار اتحادیه'].apply(add_5_years)

# ۴. ذخیره در فایل اکسل جدید
df.to_excel('output.xlsx', index=False)
print('عملیات با موفقیت انجام شد!')